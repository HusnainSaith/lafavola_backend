<dialog class="site-announcement" id="site-announcement" aria-labelledby="site-announcement-title">
  <div class="site-announcement__surface">
    <button class="site-announcement__close" type="button" aria-label="Chiudi avviso">
      <span aria-hidden="true">×</span>
    </button>
    <p class="site-announcement__eyebrow"><span aria-hidden="true">🍕</span> Avviso ai nostri clienti</p>
    <h2 id="site-announcement-title">Chiusura per ferie</h2>
    <p class="site-announcement__lead">
      La Favola Pizzeria d’Asporto Brescia sarà chiusa per ferie.
    </p>
    <div class="site-announcement__closure" aria-label="Periodo di chiusura">
      <p class="site-announcement__date">
        <span aria-hidden="true">📅</span>
        Dal <time datetime="2026-08-10">10/08/2026</time> al <time datetime="2026-08-20">20/08/2026</time>
      </p>
      <p class="site-announcement__return">
        <span aria-hidden="true">✨</span> Ci rivediamo da venerdì <strong>21/08/2026!</strong>
      </p>
    </div>
    <p class="site-announcement__note">Grazie per la vostra fiducia e buone vacanze! ☀️🏖️❤️</p>
    <div class="site-announcement__actions">
      <button class="site-announcement__dismiss" type="button">Ho capito, grazie</button>
    </div>
  </div>
</dialog>

<script is:inline src="/scripts/site-announcement.js"></script>
