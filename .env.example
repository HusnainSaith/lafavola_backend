# Application
NODE_ENV=development
PORT=3001
TYPEORM_LOGGING=false
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_me
DB_DATABASE=lafavola
DB_SSL=false

# JWT
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_32_byte_secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_TTL_DAYS=30

# CORS
FRONTEND_URLS=http://localhost:3000

# Mail / Gmail
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=La Favola
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# AWS S3
AWS_S3_ENABLED=false
AWS_REGION=
AWS_S3_BUCKET=
# Omit both static credentials when using the AWS default credential chain/IAM roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# SumUp
SUMUP_ENABLED=false
SUMUP_API_BASE_URL=https://api.sumup.com
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_CURRENCY=EUR
SUMUP_RETURN_URL=https://api.example.com/payments/webhooks/sumup
SUMUP_HOSTED_CHECKOUT_ENABLED=true
SUMUP_REQUEST_TIMEOUT_MS=10000

# AWS AppSync Events
AWS_REALTIME_ENABLED=false
AWS_APPSYNC_EVENTS_HTTP_URL=
AWS_APPSYNC_EVENTS_WS_URL=
AWS_APPSYNC_EVENTS_API_KEY=
AWS_REALTIME_TIMEOUT_MS=5000

# Firebase Cloud Messaging
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CLAIM_TIMEOUT_MS=300000

# Provider Smoke Tests (disabled until isolated credentials/resources are supplied)
RUN_SMTP_TESTS=false
SMTP_TEST_RECIPIENT=
RUN_AWS_S3_TESTS=false
AWS_S3_TEST_PREFIX=lafavola-smoke-test/
RUN_SUMUP_TESTS=false
RUN_AWS_REALTIME_TESTS=false
RUN_FIREBASE_TESTS=false
