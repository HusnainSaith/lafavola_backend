RUN_DB_TESTS=false
DB_TEST_DATABASE=lafavola_test

# Test administration connection. Values normally match local development PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_me
DB_SSL=false

MAIL_ENABLED=false
RUN_SMTP_TESTS=false
SMTP_TEST_RECIPIENT=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
AWS_S3_ENABLED=false
RUN_AWS_S3_TESTS=false
AWS_S3_TEST_PREFIX=lafavola-smoke-test/
SUMUP_ENABLED=false
SUMUP_API_BASE_URL=https://api.sumup.com
SUMUP_CURRENCY=EUR
SUMUP_HOSTED_CHECKOUT_ENABLED=true
SUMUP_REQUEST_TIMEOUT_MS=10000
RUN_SUMUP_TESTS=false
AWS_REALTIME_ENABLED=false
AWS_REALTIME_TIMEOUT_MS=5000
RUN_AWS_REALTIME_TESTS=false
PUSH_ENABLED=false
RUN_FIREBASE_TESTS=false
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CLAIM_TIMEOUT_MS=300000

# Tests refuse to reset a database unless its name ends with `_test`.
